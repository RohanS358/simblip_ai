# --- AI server (ai-server/server.mjs) ---------------------------------------
# Required: the server refuses to start without it. Generate with: openssl rand -hex 32
AI_SERVER_KEY=
# Where Ollama is listening (the model runtime the server proxies to)
OLLAMA_HOST=http://127.0.0.1:11434
# Requests running at once (the GPU is the bottleneck; 1 is the measured sweet spot on 8 GB)
AI_SERVER_CONCURRENCY=1

# --- Client side (the SIMBLIP app / any caller) -----------------------------
AI_BACKEND=ollama
OLLAMA_API_KEY=            # = AI_SERVER_KEY
OLLAMA_SCRIPT_MODEL=simblip-script
OLLAMA_EXPLAIN_MODEL=simblip-explain
